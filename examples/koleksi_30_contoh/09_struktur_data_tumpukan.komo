//! Contoh 09: Struktur Data Tumpukan (Stack LIFO)

paket contoh_09

impor "std/cetak"

tipe Tumpukan struktur {
    elemen: [bulat]
    ukuran: bulat
}

fungsi (diri: pinjam var Tumpukan) dorong(nilai: bulat) {
    diri.elemen[diri.ukuran] = nilai
    diri.ukuran += 1
}

fungsi (diri: pinjam var Tumpukan) tarik() bulat {
    jika diri.ukuran <= 0 {
        kembali 0
    }
    diri.ukuran -= 1
    kembali diri.elemen[diri.ukuran]
}

publik fungsi utama() {
    var s = Tumpukan{
        elemen: [0, 0, 0, 0, 0, 0, 0, 0],
        ukuran: 0,
    }
    s.dorong(10)
    s.dorong(20)
    biar atas = s.tarik()
    cetak.baris("Elemen teratas tumpukan: {atas}")
}
