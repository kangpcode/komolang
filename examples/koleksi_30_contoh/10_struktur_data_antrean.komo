//! Contoh 10: Struktur Data Antrean (Queue FIFO)

paket contoh_10

struktur Antrean {
    data: [bulat],
    depan: bulat,
    belakang: bulat,
}

impl Antrean {
    fungsi baru() Antrean {
        kembali Antrean {
            data: [0, 0, 0, 0, 0, 0, 0, 0],
            depan: 0,
            belakang: 0,
        }
    }

    fungsi masuk(diri: pinjam_var Antrean, nilai: bulat) {
        diri.data[diri.belakang] = nilai
        diri.belakang += 1
    }

    fungsi keluar(diri: pinjam_var Antrean) bulat {
        jika diri.depan >= diri.belakang {
            kembali 0
        }
        biar val = diri.data[diri.depan]
        diri.depan += 1
        kembali val
    }
}

publik fungsi utama() {
    var q = Antrean::baru()
    q.masuk(100)
    q.masuk(200)
    biar item = q.keluar()
    cetak("Item yang keluar pertama (FIFO): ", item)
}
