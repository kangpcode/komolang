//! Contoh 10: Struktur Data Antrean (Queue FIFO)

paket contoh_10

impor "std/cetak"

tipe Antrean struktur {
    data: [bulat]
    depan: bulat
    belakang: bulat
}

fungsi (diri: pinjam_var Antrean) masuk(nilai: bulat) {
    diri.data[diri.belakang] = nilai
    diri.belakang += 1
}

fungsi (diri: pinjam_var Antrean) keluar() bulat {
    jika diri.depan >= diri.belakang {
        kembali 0
    }
    biar val = diri.data[diri.depan]
    diri.depan += 1
    kembali val
}

publik fungsi utama() {
    var q = Antrean{
        data: [0, 0, 0, 0, 0, 0, 0, 0],
        depan: 0,
        belakang: 0,
    }
    q.masuk(100)
    q.masuk(200)
    biar item = q.keluar()
    cetak.baris("Item yang keluar pertama (FIFO): {item}")
}
