//! Contoh 29: Simulasi Fisika Gerak Partikel 2D

paket contoh_29

impor "std/cetak"

tipe Partikel2D struktur {
    x: desimal
    y: desimal
    vx: desimal
    vy: desimal
}

fungsi (diri: pinjam var Partikel2D) langkah(dt: desimal) {
    diri.x += diri.vx * dt
    diri.y += diri.vy * dt
}

publik fungsi utama() {
    var p = Partikel2D{x: 0.0, y: 0.0, vx: 10.0, vy: 5.0}
    p.langkah(0.5)
    cetak.baris("Posisi partikel x: {p.x}, y: {p.y}")
}
