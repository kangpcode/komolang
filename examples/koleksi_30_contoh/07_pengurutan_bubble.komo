//! Contoh 07: Pengurutan Gelembung (Bubble Sort)

paket contoh_07

impor "std/cetak"

fungsi urutkan(larik: pinjam_var [bulat]) {
    var panjang = 5
    untuk i dalam 0..panjang {
        untuk j dalam 0..(panjang - i - 1) {
            jika larik[j] > larik[j + 1] {
                biar temp = larik[j]
                larik[j] = larik[j + 1]
                larik[j + 1] = temp
            }
        }
    }
}

publik fungsi utama() {
    var angka = [64, 34, 25, 12, 22]
    urutkan(pinjam_var angka)
    cetak.baris("Data setelah diurutkan: ", angka[0], ", ", angka[1], ", ", angka[2])
}
