//! Contoh 28: Konkurensi Task Latar Belakang Paralel

paket contoh_28

impor "std/cetak"

fungsi proses_angka(x: bulat) bulat {
    kembali x * x
}

publik fungsi utama() {
    biar hasil1 = proses_angka(10)
    biar hasil2 = proses_angka(20)
    cetak.baris("Hasil paralel 1: ", hasil1, ", Hasil paralel 2: ", hasil2)
}
