//! Contoh 26: Aplikasi Manajemen Daftar Tugas (Todo List)

paket contoh_26

impor "std/cetak"

tipe Tugas struktur {
    judul: teks
    selesai: bool
}

fungsi (diri: pinjam_var Tugas) selesaikan() {
    diri.selesai = benar
}

publik fungsi utama() {
    var t = Tugas{judul: "Belajar Komolang", selesai: salah}
    t.selesaikan()
    cetak.baris("Tugas selesai: {t.selesai}")
}
