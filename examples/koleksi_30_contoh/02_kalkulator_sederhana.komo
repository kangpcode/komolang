//! Contoh 02: Kalkulator Aritmatika Dasar

paket contoh_02

fungsi tambah(a: bulat, b: bulat) bulat {
    kembali a + b
}

fungsi kali(a: bulat, b: bulat) bulat {
    kembali a * b
}

publik fungsi utama() {
    biar x = 25
    biar y = 4
    biar hasil_tambah = tambah(x, y)
    biar hasil_kali = kali(x, y)
    cetak("Hasil tambah: ", hasil_tambah)
    cetak("Hasil kali: ", hasil_kali)
}
