//! Contoh 05: Faktorial Rekursif

paket contoh_05

fungsi faktorial(n: bulat) bulat {
    jika n <= 1 {
        kembali 1
    }
    kembali n * faktorial(n - 1)
}

publik fungsi utama() {
    biar hasil = faktorial(6)
    cetak("6! = ", hasil)
}
