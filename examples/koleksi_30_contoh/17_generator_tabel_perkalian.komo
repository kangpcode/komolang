//! Contoh 17: Generator Tabel Perkalian Matematika

paket contoh_17

impor "std/cetak"

publik fungsi utama() {
    biar basis = 7
    cetak.baris("--- Tabel Perkalian ", basis, " ---")
    untuk i dalam 1..=5 {
        biar hasil = basis * i
        cetak.baris(basis, " x ", i, " = ", hasil)
    }
}
