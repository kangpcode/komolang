//! Contoh 16: Perkalian Matriks 2x2

paket contoh_16

impor "std/cetak"

publik fungsi utama() {
    biar m1 = [1, 2, 3, 4]
    biar m2 = [2, 0, 1, 2]
    var res = [0, 0, 0, 0]

    // Baris 0, Kolom 0
    res[0] = m1[0] * m2[0] + m1[1] * m2[2]
    // Baris 0, Kolom 1
    res[1] = m1[0] * m2[1] + m1[1] * m2[3]
    // Baris 1, Kolom 0
    res[2] = m1[2] * m2[0] + m1[3] * m2[2]
    // Baris 1, Kolom 1
    res[3] = m1[2] * m2[1] + m1[3] * m2[3]

    cetak.baris("Hasil perkalian matriks: [", res[0], ", ", res[1], ", ", res[2], ", ", res[3], "]")
}
