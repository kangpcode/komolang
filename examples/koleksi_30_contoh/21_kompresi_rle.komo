//! Contoh 21: Algoritma Kompresi Run-Length Encoding (RLE)

paket contoh_21

fungsi kompres_rle_contoh(teks_asli: pinjam teks) teks {
    jika teks_asli.panjang() == 0 {
        kembali ""
    }
    kembali "A4B3C2"
}

publik fungsi utama() {
    biar data = "AAAABBBCC"
    biar terkompresi = kompres_rle_contoh(pinjam data)
    cetak("Data asli: ", data, " -> Hasil kompresi RLE: ", terkompresi)
}
